{
    "version": "2.0.0",
    "command": "",
    "args": [],
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "odin",
            "args": [
                "build",
                ".",
                "-debug",
                "-subsystem:windows",
                "-vet-semicolon",
                "-vet-shadowing",
                "-warnings-as-errors",
                "-resource:resources.rc",
            ],
            "group": "build"
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "odin",
            "args": [
                "build",
                ".",
                "-o:speed",
                "-subsystem:windows",
                "-vet",
                "-vet-semicolon",
                "-warnings-as-errors",
                "-resource:resources.rc",
                "-out:${workspaceFolderBasename}_release.exe"
            ],
            "group": "build"
        }
    ]
}